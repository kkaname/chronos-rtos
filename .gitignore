# Build output
build/
out/
bin/
obj/
cmake-build-*/

# Compiled objects and libraries
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.d

# Executables and firmware artifacts
*.exe
*.elf
*.bin
*.hex
*.map
*.lst
